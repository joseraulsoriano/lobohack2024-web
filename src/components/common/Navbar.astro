---
import NavMobileMenu from './NavMobileMenu.vue'

export const navbarItems = [
  { title: 'Invitados', href: '/#invitados' },
  { title: 'Nuestros aliados', href: '/#aliados' },
  { title: 'Agenda', href: '/#agenda' },
  { title: 'Patrocinadores', href: '/#patrocinadores' },
]

/** Enlace opcional a registro de ediciones nuevas (aweb). Definir en Vercel: PUBLIC_REGISTRATION_URL */
const registrationUrl = import.meta.env.PUBLIC_REGISTRATION_URL?.trim() || ''
---

<Fragment>
  <nav class="relative z-2 bg-none p-4">
    <div class="hidden h-10 w-full flex-1 items-center justify-between px-2 lg:flex">
      <a href="/" class="mr-auto">
        <div class="i-solar:home-2-broken hw-6"></div>
      </a>
      <ul class="flex items-center space-x-4">
        {
          navbarItems.map((item) => (
            <li class="group">
              <a
                href={item.href}
                class="rounded-md px-3 py-2 text-sm text-primary-600 font-medium"
                hover="bg-base-700/65 text-primary rounded-none"
              >
                <span uppercase>
                  {item.title}
                  <span class="invisible group-hover:animate-blink">_</span>
                </span>
              </a>
            </li>
          ))
        }
        {
          registrationUrl ? (
            <li>
              <a
                href={registrationUrl}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'relative',
                  'inline-block',
                  'text-center',
                  'tracking-[0.3em]',
                  'text-sm',
                  'font-bold',
                  'uppercase',
                  'px-6',
                  'py-2',
                  'border-2',
                  'border-solid',
                  'border-primary',
                  'text-primary',
                ]}
              >
                Registro 2026
              </a>
            </li>
          ) : null
        }
      </ul>
    </div>

    <div class="h-10 w-full flex items-center justify-between lg:hidden">
      <a href="/">
        <div class="i-solar:home-2-broken hw-6"></div>
      </a>
      <NavMobileMenu client:visible>
        <ul class="w-full flex flex-col items-center divide-y-2 divide-primary">
          {
            navbarItems.map((item) => (
              <li class="group w-full py-2" hover="bg-base-700/65 text-primary rounded-none">
                <a
                  href={item.href}
                  class="w-full flex justify-center rounded-md py-2 text-sm text-primary-600 font-medium"
                >
                  <span uppercase>
                    {item.title}
                    <span class="invisible group-hover:animate-blink">_</span>
                  </span>
                </a>
              </li>
            ))
          }
          {
            registrationUrl ? (
              <li class="w-full flex justify-center py-2">
                <a
                  href={registrationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="py-4 text-sm text-primary font-bold uppercase"
                >
                  Registro 2026
                </a>
              </li>
            ) : null
          }
        </ul>
      </NavMobileMenu>
    </div>
  </nav>
</Fragment>
